@echo off
chcp 65001 >nul
cls
echo =======================================================================
echo         Agent Phone Toolkit - 跨设备剪切板双向无感同步安装程序
echo =======================================================================
echo.
echo  [1/3] 正在配置系统应用程序目录并创建开机自启动服务...
"%~dp0clipboard_sync.exe" --install
echo.
echo =======================================================================
echo                  ★ 手机端设置重要提醒 (只需一次) ★
echo =======================================================================
echo.
echo  1. 手机开启【USB 调试】:
echo     - 打开手机【设置 -> 关于本机 -> 版本信息】，连续点击【版本号】5 次；
echo     - 返回打开【设置 -> 系统/其他设置 -> 开发者选项】；
echo     - 开启【USB 调试】开关；
echo     - (ColorOS / OPPO 用户特别提醒: 务必同时开启【禁止权限监控】)
echo.
echo  2. 建立网络连接 (任选其一):
echo     - 方式 A【手机热点直连 (强烈推荐)】:
echo       手机开启个人热点，电脑连上该热点 (即使手机关掉流量也能免流直连)！
echo     - 方式 B【局域网 Wi-Fi 直连】:
echo       手机与电脑连接同一台路由器的 Wi-Fi。
echo.
echo  3. 手机屏幕授权弹窗:
echo     - 首次连接时手机若弹出「允许 USB 调试吗？」，
echo     - 请勾选【始终允许来自此计算机的调试】并点击【确定】。
echo.
echo =======================================================================
echo   [OK] 安装全部完成！
echo   - 桌面快捷方式已生成 (带专属高清图标)
echo   - Windows 开机自启服务已生效
echo   - 守护进程已在后台隐形静默运行，您可以随时关闭此窗口！
echo =======================================================================
echo.
pause
